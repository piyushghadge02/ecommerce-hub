# Copy to .env and adjust for your machine. Never commit .env.

# --- PostgreSQL (authoritative orders/users) ---
POSTGRES_DSN=postgresql+asyncpg://ecom:ecom@localhost:5432/ecommerce

# --- MongoDB (product catalog) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ecommerce

# --- Elasticsearch (order search index) ---
ELASTICSEARCH_URL=http://localhost:9200
ES_INDEX=orders

# --- Order -> Elasticsearch sync strategy: dual_write | outbox | polling ---
SYNC_STRATEGY=dual_write
OUTBOX_POLL_SECONDS=2
POLLING_INTERVAL_SECONDS=15

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
